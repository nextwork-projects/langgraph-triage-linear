# Google Cloud project with Vertex AI (aiplatform.googleapis.com) enabled
GOOGLE_CLOUD_PROJECT=your-project-id

# Langfuse Cloud (US region). Keys from Project Settings > API Keys.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=dev

# Linear (Settings > Security & access > Personal API keys). Full access: it creates
# the teams, the labels and the webhook. Sent with no "Bearer" prefix.
LINEAR_API_KEY=lin_api_...

# The webhook's signing secret. python linear_webhook.py <url> prints a new one.
LINEAR_WEBHOOK_SECRET=

# Leave unset to save checkpoints in local SQLite. On Cloud Run it comes from Secret Manager:
# postgresql://triage:<password>@/triage?host=/cloudsql/<project>:<region>:<instance>
DATABASE_URL=

# The fix PR. A fine-grained PAT for your triage-services repo only:
# Contents and Pull requests, read and write. Leave unset to skip the fix.
GITHUB_TOKEN=
GITHUB_REPO=your-github-user/triage-services

